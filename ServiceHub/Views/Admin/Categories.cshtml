@using ServiceHub.Models
@model List<ServiceHub.Models.Category>
@{
    ViewData["Title"] = "Category Management";
}

<div style="background:linear-gradient(135deg,#0F172A,#1E1B4B);padding:40px 0 28px;">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h1 style="color:white;font-weight:800;font-size:1.8rem;margin-bottom:6px;">
                    <i class="fas fa-th-large me-2" style="color:#818CF8;"></i>Category Management
                </h1>
                <p style="color:rgba(255,255,255,0.6);margin:0;">Manage service categories and their assignments</p>
            </div>
            <a asp-controller="Admin" asp-action="Dashboard" class="btn-hub-ghost" style="color:white;border-color:rgba(255,255,255,0.2);">
                <i class="fas fa-arrow-left me-1"></i>Dashboard
            </a>
        </div>
    </div>
</div>

<div class="container" style="padding:40px 15px;">
    <div class="row g-4">
        <!-- Add Category Form -->
        <div class="col-lg-4">
            <div class="card-hub p-4">
                <h5 style="font-weight:800;margin-bottom:20px;"><i class="fas fa-plus-circle me-2 text-primary"></i>Add New Category</h5>
                <form asp-controller="Admin" asp-action="CreateCategory" method="post" class="form-hub">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label">Name <span class="text-danger">*</span></label>
                        <input type="text" name="Name" class="form-control" placeholder="e.g., Landscaping" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <textarea name="Description" class="form-control" rows="3" placeholder="Brief description..."></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Font Awesome Icon Class</label>
                        <input type="text" name="IconClass" class="form-control" placeholder="fas fa-leaf" />
                        <div style="font-size:0.75rem;color:#94A3B8;margin-top:4px;">e.g., fas fa-bolt, fas fa-broom</div>
                    </div>
                    <div class="mb-4">
                        <label class="form-label">Image URL</label>
                        <input type="url" name="ImageUrl" class="form-control" placeholder="https://images.unsplash.com/..." />
                    </div>
                    <button type="submit" class="btn-hub-primary w-100" style="padding:12px;">
                        <i class="fas fa-plus me-2"></i>Create Category
                    </button>
                </form>
            </div>
        </div>

        <!-- Categories Grid -->
        <div class="col-lg-8">
            <div class="row g-3">
                @foreach (var cat in Model)
                {
                    <div class="col-12 col-md-6">
                        <div class="card-hub p-4 @(!cat.IsActive ? "opacity-50" : "")">
                            <div class="d-flex align-items-start gap-3">
                                @if (!string.IsNullOrEmpty(cat.ImageUrl))
                                {
                                    <img src="@cat.ImageUrl" alt="@cat.Name" style="width:56px;height:56px;border-radius:10px;object-fit:cover;flex-shrink:0;"
                                         onerror="this.onerror=null;this.src='/images/default-service.svg';" />
                                }
                                else
                                {
                                    <div style="width:56px;height:56px;background:rgba(79,70,229,0.1);border-radius:10px;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                                        <i class="@(cat.IconClass ?? "fas fa-tag")" style="color:#4F46E5;font-size:1.3rem;"></i>
                                    </div>
                                }
                                <div class="flex-grow-1">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div>
                                            <h6 style="font-weight:700;margin-bottom:2px;">@cat.Name</h6>
                                            <span style="font-size:0.75rem;color:#94A3B8;">@cat.Services.Count service@(cat.Services.Count != 1 ? "s" : "")</span>
                                        </div>
                                        @if (cat.IsActive)
                                        {
                                            <form asp-controller="Admin" asp-action="DeleteCategory" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@cat.Id" />
                                                <button type="submit" class="btn btn-sm" data-confirm="Deactivate '@cat.Name'?"
                                                        style="background:rgba(239,68,68,0.08);color:#DC2626;border:1px solid rgba(239,68,68,0.2);border-radius:7px;padding:4px 10px;font-size:0.78rem;">
                                                    <i class="fas fa-trash-alt"></i>
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span style="background:rgba(239,68,68,0.08);color:#DC2626;padding:2px 8px;border-radius:999px;font-size:0.72rem;font-weight:600;">Inactive</span>
                                        }
                                    </div>
                                    @if (!string.IsNullOrEmpty(cat.Description))
                                    {
                                        <p style="font-size:0.8rem;color:#64748B;margin:6px 0 0;" class="truncate-2">@cat.Description</p>
                                    }
                                    @if (!string.IsNullOrEmpty(cat.IconClass))
                                    {
                                        <div style="font-size:0.75rem;color:#94A3B8;margin-top:4px;"><i class="@cat.IconClass me-1 text-primary"></i><code>@cat.IconClass</code></div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
