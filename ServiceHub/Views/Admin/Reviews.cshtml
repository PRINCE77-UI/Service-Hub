@using ServiceHub.Models
@model List<ServiceHub.Models.Review>
@{
    ViewData["Title"] = "System Reviews";
}

<div style="background:linear-gradient(135deg,#0F172A,#1E1B4B);padding:40px 0 28px;">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h1 style="color:white;font-weight:800;font-size:1.8rem;margin-bottom:6px;">
                    <i class="fas fa-star me-2" style="color:#F59E0B;"></i>System Reviews
                </h1>
                <p style="color:rgba(255,255,255,0.6);margin:0;">Audit view of customer feedback</p>
            </div>
            <a asp-controller="Admin" asp-action="Dashboard" class="btn-hub-ghost" style="color:white;border-color:rgba(255,255,255,0.2);">
                <i class="fas fa-arrow-left me-1"></i>Dashboard
            </a>
        </div>
    </div>
</div>

<div class="container" style="padding:40px 15px;">
    <div class="card-hub overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hub mb-0">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Customer</th>
                        <th>Service / Provider</th>
                        <th>Rating</th>
                        <th>Comment</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var review in Model)
                    {
                        <tr>
                            <td style="font-size:0.85rem;color:#64748B;white-space:nowrap;">@review.ReviewDate.ToString("MMM d, yyyy")</td>
                            <td>
                                <div style="font-weight:600;font-size:0.85rem;">@review.Customer?.FullName</div>
                                <div style="font-size:0.75rem;color:#94A3B8;">@review.Customer?.Email</div>
                            </td>
                            <td>
                                <div style="font-weight:600;font-size:0.85rem;" class="truncate-2" style="max-width:200px;">@review.Service?.Title</div>
                                <div style="font-size:0.75rem;color:#94A3B8;"><i class="fas fa-user me-1"></i>@review.Service?.Provider?.FullName</div>
                            </td>
                            <td>
                                <div class="star-rating" style="font-size:0.8rem;white-space:nowrap;">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        <i class="@(i <= review.Rating ? "fas fa-star" : "far fa-star")"></i>
                                    }
                                </div>
                            </td>
                            <td>
                                <p style="font-size:0.85rem;color:#475569;margin:0;max-width:300px;" class="truncate-2" title="@review.Comment">
                                    @(string.IsNullOrEmpty(review.Comment) ? "—" : review.Comment)
                                </p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
