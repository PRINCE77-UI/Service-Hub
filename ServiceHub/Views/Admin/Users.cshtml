@using ServiceHub.Models
@model List<(ApplicationUser User, IList<string> Roles)>
@{
    ViewData["Title"] = "User Management";
}

<div style="background:linear-gradient(135deg,#0F172A,#1E1B4B);padding:40px 0 28px;">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h1 style="color:white;font-weight:800;font-size:1.8rem;margin-bottom:6px;">
                    <i class="fas fa-users me-2" style="color:#818CF8;"></i>User Management
                </h1>
                <p style="color:rgba(255,255,255,0.6);margin:0;">@Model.Count total users registered</p>
            </div>
            <a asp-controller="Admin" asp-action="Dashboard" class="btn-hub-ghost" style="color:white;border-color:rgba(255,255,255,0.2);">
                <i class="fas fa-arrow-left me-1"></i>Dashboard
            </a>
        </div>
    </div>
</div>

<div class="container" style="padding:40px 15px;">
    <!-- Search bar -->
    <div class="mb-4">
        <div class="input-group" style="max-width:400px;">
            <span class="input-group-text"><i class="fas fa-search"></i></span>
            <input type="text" id="userSearch" class="form-control" placeholder="Search users by name or email..." />
        </div>
    </div>

    <div class="card-hub overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hub mb-0" id="usersTable">
                <thead>
                    <tr>
                        <th>User</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th>City</th>
                        <th>Status</th>
                        <th>Joined</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var (user, roles) in Model)
                    {
                        var isLocked = user.LockoutEnd.HasValue && user.LockoutEnd.Value > DateTimeOffset.UtcNow;
                        <tr data-search="@user.FullName @user.Email">
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    @if (!string.IsNullOrEmpty(user.ProfilePictureUrl))
                                    {
                                        <img src="@user.ProfilePictureUrl" style="width:36px;height:36px;border-radius:50%;object-fit:cover;" alt="@user.FullName"
                                             onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=200&q=80';" />
                                    }
                                    else
                                    {
                                        <div class="avatar-placeholder" style="width:36px;height:36px;font-size:0.8rem;">@user.FullName.FirstOrDefault()</div>
                                    }
                                    <div>
                                        <div style="font-weight:700;font-size:0.88rem;">@user.FullName</div>
                                        @if (user.IsVerified)
                                        {
                                            <span class="verified-badge" style="font-size:0.65rem;"><i class="fas fa-check-circle"></i>Verified</span>
                                        }
                                    </div>
                                </div>
                            </td>
                            <td style="font-size:0.85rem;color:#64748B;">@user.Email</td>
                            <td>
                                @foreach (var role in roles)
                                {
                                    <span class="role-badge @(role == "Admin" ? "role-admin" : role == "ServiceProvider" ? "role-provider" : "role-customer")">
                                        @role
                                    </span>
                                }
                            </td>
                            <td style="font-size:0.85rem;color:#64748B;">@(user.City ?? "—")</td>
                            <td>
                                @if (isLocked)
                                {
                                    <span class="badge-status badge-rejected"><i class="fas fa-lock me-1"></i>Locked</span>
                                }
                                else
                                {
                                    <span class="badge-status badge-completed"><i class="fas fa-check me-1"></i>Active</span>
                                }
                            </td>
                            <td style="font-size:0.82rem;color:#94A3B8;">@user.CreatedAt.ToString("MMM d, yyyy")</td>
                            <td>
                                <div class="d-flex gap-1 flex-wrap">
                                    <form asp-controller="Admin" asp-action="ToggleLock" method="post" style="margin:0;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="userId" value="@user.Id" />
                                        <button type="submit" title="@(isLocked ? "Unlock" : "Lock")"
                                                data-confirm="@(isLocked ? $"Unlock {user.FullName}?" : $"Lock {user.FullName}?")"
                                                class="btn btn-sm"
                                                style="@(isLocked ? "background:rgba(16,185,129,0.08);color:#059669;border:1px solid rgba(16,185,129,0.2);" : "background:rgba(239,68,68,0.08);color:#DC2626;border:1px solid rgba(239,68,68,0.2);")border-radius:7px;padding:4px 10px;font-size:0.78rem;">
                                            <i class="fas @(isLocked ? "fa-unlock" : "fa-lock")"></i>
                                        </button>
                                    </form>
                                    @if (roles.Contains("ServiceProvider"))
                                    {
                                        <form asp-controller="Admin" asp-action="VerifyProvider" method="post" style="margin:0;">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="userId" value="@user.Id" />
                                            <button type="submit" title="@(user.IsVerified ? "Revoke Verification" : "Verify Provider")"
                                                    class="btn btn-sm"
                                                    style="background:rgba(79,70,229,0.08);color:#4F46E5;border:1px solid rgba(79,70,229,0.2);border-radius:7px;padding:4px 10px;font-size:0.78rem;">
                                                <i class="fas @(user.IsVerified ? "fa-times-circle" : "fa-check-circle")"></i>
                                                @(user.IsVerified ? "Revoke" : "Verify")
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.getElementById('userSearch').addEventListener('input', function () {
        const q = this.value.toLowerCase();
        document.querySelectorAll('#usersTable tbody tr').forEach(row => {
            row.style.display = row.dataset.search.toLowerCase().includes(q) ? '' : 'none';
        });
    });
</script>
}
