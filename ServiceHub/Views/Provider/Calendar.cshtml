@using ServiceHub.Models
@model List<ServiceHub.Models.Booking>
@{
    ViewData["Title"] = "My Schedule";
}

<div style="background:linear-gradient(135deg,#0F172A,#064E3B);padding:40px 0 28px;">
    <div class="container">
        <h1 style="color:white;font-weight:800;font-size:1.8rem;margin-bottom:6px;">
            <i class="fas fa-calendar-alt me-2" style="color:#34D399;"></i>My Schedule
        </h1>
        <p style="color:rgba(255,255,255,0.6);margin:0;">Overview of your upcoming appointments</p>
    </div>
</div>

<div class="container" style="padding:40px 15px;">
    @if (!Model.Any())
    {
        <div class="empty-state">
            <div class="empty-state-icon"><i class="fas fa-calendar-times"></i></div>
            <h4>No upcoming appointments</h4>
            <p>Accept bookings from your dashboard to see them here.</p>
            <a asp-controller="Provider" asp-action="Dashboard" class="btn-hub-primary mt-3">
                <i class="fas fa-arrow-left me-1"></i>Go to Dashboard
            </a>
        </div>
    }
    else
    {
        var grouped = Model.GroupBy(b => b.BookingDate.Date).OrderBy(g => g.Key);

        @foreach (var group in grouped)
        {
            <div class="mb-4">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div style="background:#4F46E5;color:white;border-radius:12px;padding:10px 18px;text-align:center;min-width:70px;">
                        <div style="font-size:1.5rem;font-weight:800;line-height:1;">@group.Key.Day</div>
                        <div style="font-size:0.7rem;font-weight:600;text-transform:uppercase;opacity:0.8;">@group.Key.ToString("MMM")</div>
                    </div>
                    <div>
                        <div style="font-weight:700;font-size:1rem;">@group.Key.ToString("dddd, MMMM d, yyyy")</div>
                        <div style="font-size:0.82rem;color:#64748B;">@group.Count() appointment@(group.Count() > 1 ? "s" : "")</div>
                    </div>
                </div>

                <div class="row g-2 ms-0">
                    @foreach (var booking in group.OrderBy(b => b.StartTime))
                    {
                        <div class="col-12">
                            <div class="calendar-slot">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div class="d-flex align-items-center gap-3">
                                        <div style="font-weight:800;color:#4F46E5;font-size:0.9rem;min-width:110px;">
                                            @DateTime.Today.Add(booking.StartTime).ToString("h:mm tt") –
                                            @DateTime.Today.Add(booking.EndTime).ToString("h:mm tt")
                                        </div>
                                        <div>
                                            <div style="font-weight:700;font-size:0.9rem;">@booking.Service?.Title</div>
                                            <div style="font-size:0.8rem;color:#64748B;">
                                                <i class="fas fa-user me-1"></i>@booking.Customer?.FullName
                                                @if (!string.IsNullOrEmpty(booking.Customer?.PhoneNumber))
                                                {
                                                    <span class="ms-2"><i class="fas fa-phone me-1"></i>@booking.Customer.PhoneNumber</span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="badge-status badge-@booking.Status.ToString().ToLower()">@booking.Status</span>
                                        <span style="font-weight:700;color:#4F46E5;">&#8377;@booking.TotalAmount.ToString("N0")</span>
                                    </div>
                                </div>
                                @if (!string.IsNullOrEmpty(booking.Notes))
                                {
                                    <div style="font-size:0.78rem;color:#94A3B8;margin-top:8px;border-top:1px solid rgba(79,70,229,0.1);padding-top:8px;">
                                        <i class="fas fa-sticky-note me-1"></i>@booking.Notes
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    }
</div>
