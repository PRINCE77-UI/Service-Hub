@{
    ViewData["Title"] = "Register";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Create Account — ServiceHub</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="auth-page">
<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-sm-10 col-md-8 col-lg-6">
            <div class="auth-card fade-in-up">
                <div class="text-center mb-4">
                    <a asp-controller="Home" asp-action="Index" class="auth-logo d-block mb-3">
                        <i class="fas fa-layer-group me-2"></i>ServiceHub
                    </a>
                    <h2 style="font-size:1.5rem;font-weight:800;color:#0F172A;margin-bottom:6px;">Create Your Account</h2>
                    <p style="color:#64748B;font-size:0.9rem;">Join the ServiceHub community today</p>
                </div>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger rounded-3 mb-3" style="font-size:0.85rem;">
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <div><i class="fas fa-exclamation-circle me-1"></i>@error.ErrorMessage</div>
                        }
                    </div>
                }

                <form asp-controller="Account" asp-action="Register" method="post" class="form-hub">
                    @Html.AntiForgeryToken()

                    <!-- Role Selection -->
                    <div class="mb-4">
                        <label class="form-label">I want to join as</label>
                        <div class="row g-2">
                            <div class="col-6">
                                <input type="radio" name="Role" id="roleCustomer" value="Customer" class="d-none" checked />
                                <label for="roleCustomer" class="role-select-card text-center p-3 rounded-3 border d-block cursor-pointer"
                                       style="border-color:#4F46E5 !important;background:rgba(79,70,229,0.06);">
                                    <i class="fas fa-user-circle mb-2" style="font-size:1.8rem;color:#4F46E5;display:block;"></i>
                                    <div style="font-weight:700;font-size:0.9rem;color:#0F172A;">Customer</div>
                                    <div style="font-size:0.75rem;color:#64748B;">Book services</div>
                                </label>
                            </div>
                            <div class="col-6">
                                <input type="radio" name="Role" id="roleProvider" value="ServiceProvider" class="d-none" />
                                <label for="roleProvider" class="role-select-card text-center p-3 rounded-3 border d-block cursor-pointer"
                                       style="border-color:#E2E8F0;cursor:pointer;">
                                    <i class="fas fa-toolbox mb-2" style="font-size:1.8rem;color:#10B981;display:block;"></i>
                                    <div style="font-weight:700;font-size:0.9rem;color:#0F172A;">Service Provider</div>
                                    <div style="font-size:0.75rem;color:#64748B;">Offer services</div>
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label"><i class="fas fa-user me-1 text-muted"></i>Full Name</label>
                        <input type="text" name="FullName" class="form-control" placeholder="Rajesh Sharma" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label"><i class="fas fa-envelope me-1 text-muted"></i>Email Address</label>
                        <input type="email" name="Email" class="form-control" placeholder="you@example.com" required />
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label class="form-label"><i class="fas fa-map-marker-alt me-1 text-muted"></i>City</label>
                            <select name="City" class="form-select">
                                <option value="">Select City</option>
                                @foreach (var city in ServiceHub.Models.IndianCities.All)
                                {
                                    <option value="@city">@city</option>
                                }
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label"><i class="fas fa-phone me-1 text-muted"></i>Phone</label>
                            <input type="tel" name="PhoneNumber" class="form-control" placeholder="+91 98200 12345" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label"><i class="fas fa-lock me-1 text-muted"></i>Password</label>
                        <input type="password" name="Password" class="form-control" placeholder="Min. 8 chars, 1 uppercase, 1 symbol" required />
                        <div style="font-size:0.75rem;color:#94A3B8;margin-top:4px;">Example: Customer@123!</div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label"><i class="fas fa-lock me-1 text-muted"></i>Confirm Password</label>
                        <input type="password" name="ConfirmPassword" class="form-control" placeholder="Confirm your password" required />
                    </div>

                    <button type="submit" class="btn-hub-primary w-100 mb-3" style="padding:14px;">
                        <i class="fas fa-rocket me-2"></i>Create Account
                    </button>
                </form>

                <div class="text-center" style="font-size:0.9rem;color:#64748B;">
                    Already have an account?
                    <a asp-controller="Account" asp-action="Login" style="font-weight:700;color:#4F46E5;">Sign In</a>
                </div>
            </div>
        </div>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script>
    // Role card toggle
    document.querySelectorAll('input[name="Role"]').forEach(radio => {
        radio.addEventListener('change', function () {
            document.querySelectorAll('.role-select-card').forEach(card => {
                card.style.borderColor = '#E2E8F0';
                card.style.background = '';
            });
            this.nextElementSibling.style.borderColor = '#4F46E5';
            this.nextElementSibling.style.background = 'rgba(79,70,229,0.06)';
        });
    });
    document.querySelectorAll('.role-select-card').forEach(card => {
        card.style.cursor = 'pointer';
        card.addEventListener('click', function() {
            const radio = document.getElementById(this.getAttribute('for'));
            if(radio) radio.dispatchEvent(new Event('change'));
        });
    });
</script>
</body>
</html>
