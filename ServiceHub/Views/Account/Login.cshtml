@{
    ViewData["Title"] = "Login";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign In — ServiceHub</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="auth-page">
<div class="container">
    <div class="row justify-content-center">
        <div class="col-12 col-sm-10 col-md-8 col-lg-5">
            <div class="auth-card fade-in-up">
                <div class="text-center mb-4">
                    <a asp-controller="Home" asp-action="Index" class="auth-logo d-block mb-3">
                        <i class="fas fa-layer-group me-2"></i>ServiceHub
                    </a>
                    <h2 style="font-size:1.5rem;font-weight:800;color:#0F172A;margin-bottom:6px;">Welcome Back</h2>
                    <p style="color:#64748B;font-size:0.9rem;">Sign in to your account to continue</p>
                </div>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger rounded-3 mb-3" style="font-size:0.85rem;">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <div>@error.ErrorMessage</div>
                        }
                    </div>
                }

                <form asp-controller="Account" asp-action="Login" method="post" class="form-hub">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="ReturnUrl" value="@ViewData["ReturnUrl"]" />

                    <div class="mb-3">
                        <label class="form-label"><i class="fas fa-envelope me-1 text-muted"></i>Email Address</label>
                        <input type="email" name="Email" class="form-control" placeholder="you@example.com"
                                required />
                    </div>

                    <div class="mb-4">
                        <label class="form-label"><i class="fas fa-lock me-1 text-muted"></i>Password</label>
                        <div class="input-group">
                            <input type="password" name="Password" id="passwordInput" class="form-control"
                                   placeholder="Your password"  required />
                            <button type="button" class="input-group-text" onclick="togglePwd()" style="cursor:pointer;">
                                <i class="fas fa-eye" id="eyeIcon"></i>
                            </button>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="RememberMe" id="rememberMe" />
                            <label class="form-check-label" for="rememberMe" style="font-size:0.85rem;color:#64748B;">Remember me</label>
                        </div>
                        <a href="#" style="font-size:0.85rem;color:#4F46E5;font-weight:600;">Forgot password?</a>
                    </div>

                    <button type="submit" class="btn-hub-primary w-100 mb-3" style="padding:14px;">
                        <i class="fas fa-sign-in-alt me-2"></i>Sign In
                    </button>
                </form>

                <div class="text-center" style="font-size:0.9rem;color:#64748B;">
                    Don't have an account?
                    <a asp-controller="Account" asp-action="Register" style="font-weight:700;color:#4F46E5;">Create Account</a>
                </div>
            </div>
        </div>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script>
    function togglePwd() {
        const input = document.getElementById('passwordInput');
        const icon = document.getElementById('eyeIcon');
        if (input.type === 'password') { input.type = 'text'; icon.classList.replace('fa-eye', 'fa-eye-slash'); }
        else { input.type = 'password'; icon.classList.replace('fa-eye-slash', 'fa-eye'); }
    }
</script>
</body>
</html>
