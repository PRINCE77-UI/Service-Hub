@using ServiceHub.Models
@model ServiceHub.Models.ViewModels.BookingCreateViewModel
@{
    ViewData["Title"] = "Book Service";
}

<div class="container" style="max-width:900px;padding:40px 15px;">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb" style="font-size:0.85rem;">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li class="breadcrumb-item"><a asp-controller="Services" asp-action="Details" asp-route-id="@Model.ServiceId">@Model.Service?.Title</a></li>
            <li class="breadcrumb-item active">Book Now</li>
        </ol>
    </nav>

    <div class="row g-4">
        <!-- Booking Form -->
        <div class="col-lg-7">
            <div class="card-hub p-4">
                <h2 style="font-size:1.3rem;font-weight:800;margin-bottom:4px;">
                    <i class="fas fa-calendar-plus me-2" style="color:#4F46E5;"></i>Book This Service
                </h2>
                <p style="color:#64748B;font-size:0.88rem;margin-bottom:24px;">Select your preferred date and time slot</p>

                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger rounded-3 mb-4" style="font-size:0.85rem;">
                        <i class="fas fa-exclamation-triangle me-2"></i>@TempData["Error"]
                    </div>
                }

                <form asp-controller="Bookings" asp-action="Create" method="post" class="form-hub">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="ServiceId" value="@Model.ServiceId" />
                    <input type="hidden" id="TotalAmount" name="TotalAmount" value="@Model.TotalAmount" />
                    <input type="hidden" id="pricePerUnit" value="@Model.Service?.Price" />
                    <input type="hidden" id="priceType" value="@Model.Service?.PriceType.ToString()" />

                    <div class="mb-3">
                        <label class="form-label">
                            <i class="fas fa-calendar me-1"></i>Booking Date <span class="text-danger">*</span>
                        </label>
                        <input type="date" name="BookingDate" id="BookingDate" class="form-control"
                               value="@Model.BookingDate.ToString("yyyy-MM-dd")"
                               min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" required />
                        <div style="font-size:0.75rem;color:#94A3B8;margin-top:4px;">Select a future date for your booking</div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label class="form-label">
                                <i class="fas fa-clock me-1"></i>Start Time <span class="text-danger">*</span>
                            </label>
                            <input type="time" name="StartTime" id="StartTime" class="form-control"
                                   value="@Model.StartTime" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label">
                                <i class="fas fa-clock me-1"></i>End Time <span class="text-danger">*</span>
                            </label>
                            <input type="time" name="EndTime" id="EndTime" class="form-control"
                                   value="@Model.EndTime" required />
                        </div>
                    </div>

                    <!-- Price Calculator -->
                    <div style="background:#F0F9FF;border:1px solid #BAE6FD;border-radius:12px;padding:16px;margin-bottom:20px;">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <div style="font-size:0.85rem;font-weight:600;color:#0369A1;">Estimated Total</div>
                                <div style="font-size:0.75rem;color:#64748B;">
                                    &#8377;@Model.Service?.Price.ToString("N0") / @Model.Service?.PriceType.ToString().ToLower()
                                    @if (Model.Service?.PriceType == PriceType.Hourly)
                                    {
                                        <span>× hours</span>
                                    }
                                </div>
                            </div>
                            <div id="priceDisplay" style="font-size:1.8rem;font-weight:800;color:#4F46E5;font-family:'Plus Jakarta Sans',sans-serif;">
                                &#8377;@Model.TotalAmount.ToString("N0")
                            </div>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label"><i class="fas fa-sticky-note me-1"></i>Additional Notes</label>
                        <textarea name="Notes" class="form-control" rows="3"
                                  placeholder="Any specific requirements or instructions for the provider...">@Model.Notes</textarea>
                    </div>

                    <!-- Conflict Notice -->
                    <div style="background:#FFFBEB;border:1px solid #FDE68A;border-radius:10px;padding:12px;margin-bottom:20px;font-size:0.82rem;">
                        <i class="fas fa-shield-alt me-2" style="color:#D97706;"></i>
                        <strong style="color:#92400E;">Conflict Protection:</strong>
                        <span style="color:#78350F;">Your booking uses our real-time slot conflict detection to prevent double-booking.</span>
                    </div>

                    <button type="submit" class="btn-hub-primary w-100" style="padding:14px;">
                        <i class="fas fa-lock me-2"></i>Confirm Booking
                    </button>

                    <a asp-controller="Services" asp-action="Details" asp-route-id="@Model.ServiceId"
                       class="btn-hub-ghost w-100 mt-2 d-block text-center" style="padding:12px;">
                        Cancel
                    </a>
                </form>
            </div>
        </div>

        <!-- Service Summary -->
        <div class="col-lg-5">
            <div style="position:sticky;top:90px;">
                <div class="card-hub p-4">
                    <h5 style="font-size:0.85rem;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;color:#64748B;margin-bottom:16px;">
                        Service Summary
                    </h5>

                    @if (Model.Service != null)
                    {
                        <img src="@(Model.Service.ImageUrl ?? "/images/default-service.svg")"
                             alt="@Model.Service.Title" style="width:100%;height:140px;object-fit:cover;border-radius:10px;margin-bottom:16px;"
                             onerror="this.onerror=null;this.src='/images/default-service.svg';" />

                        <h5 style="font-size:1rem;font-weight:700;margin-bottom:10px;">@Model.Service.Title</h5>

                        <div class="d-flex align-items-center gap-2 mb-3">
                            <div class="avatar-placeholder" style="width:32px;height:32px;font-size:0.75rem;">
                                @(Model.Service.Provider?.FullName?.FirstOrDefault().ToString().ToUpper() ?? "P")
                            </div>
                            <div>
                                <div style="font-size:0.85rem;font-weight:600;">@Model.Service.Provider?.FullName</div>
                                @if (!string.IsNullOrEmpty(Model.Service.City))
                                {
                                    <div style="font-size:0.75rem;color:#94A3B8;"><i class="fas fa-map-marker-alt me-1"></i>@Model.Service.City</div>
                                }
                            </div>
                        </div>

                        <div style="border-top:1px solid #F1F5F9;padding-top:14px;">
                            <div class="d-flex justify-content-between mb-2" style="font-size:0.85rem;">
                                <span style="color:#64748B;">Base Rate:</span>
                                <span style="font-weight:700;">&#8377;@Model.Service.Price.ToString("N0") / @Model.Service.PriceType.ToString().ToLower()</span>
                            </div>
                            @if (!string.IsNullOrEmpty(Model.Service.WorkDays))
                            {
                                <div class="d-flex justify-content-between mb-2" style="font-size:0.85rem;">
                                    <span style="color:#64748B;">Available:</span>
                                    <span style="font-weight:600;color:#374151;">@Model.Service.WorkDays</span>
                                </div>
                            }
                        </div>

                        <div style="background:rgba(79,70,229,0.06);border-radius:10px;padding:12px;margin-top:12px;">
                            <div style="font-size:0.78rem;color:#64748B;display:flex;flex-direction:column;gap:6px;">
                                <div><i class="fas fa-check-circle me-2 text-success"></i>Free cancellation before 24hrs</div>
                                <div><i class="fas fa-check-circle me-2 text-success"></i>Email confirmation sent</div>
                                <div><i class="fas fa-check-circle me-2 text-success"></i>Real-time conflict protection</div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // Initialize booking price calculator
    initBookingForm();
</script>
}
