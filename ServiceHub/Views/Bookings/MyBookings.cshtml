@using ServiceHub.Models
@model ServiceHub.Models.ViewModels.CustomerDashboardViewModel
@{
    ViewData["Title"] = "My Bookings";

    Func<Booking, object> BookingCard = @<div class="col-12">
        <div class="booking-card @item.Status.ToString().ToLower()">
            <div class="d-flex flex-wrap align-items-start justify-content-between gap-3">
                <div class="d-flex gap-3 align-items-start">
                    <div class="avatar-placeholder" style="width:48px;height:48px;border-radius:12px;">
                        <i class="@(item.Service?.Category?.IconClass ?? "fas fa-wrench")"></i>
                    </div>
                    <div>
                        <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                            <h6 style="font-weight:700;margin:0;">@item.Service?.Title</h6>
                            @if (!string.IsNullOrEmpty(item.Service?.Category?.Name))
                            {
                                <span class="badge rounded-pill" style="background:rgba(79,70,229,0.1);color:#4F46E5;font-size:0.72rem;font-weight:600;">
                                    @item.Service.Category.Name
                                </span>
                            }
                        </div>
                        <p style="font-size:0.82rem;color:#64748B;margin-bottom:6px;">
                            <i class="fas fa-user me-1"></i>@item.Service?.Provider?.FullName
                        </p>
                        <div class="d-flex flex-wrap gap-3" style="font-size:0.8rem;color:#64748B;">
                            <span><i class="fas fa-calendar me-1"></i>@item.BookingDate.ToString("MMM d, yyyy")</span>
                            <span><i class="fas fa-clock me-1"></i>@DateTime.Today.Add(item.StartTime).ToString("h:mm tt") – @DateTime.Today.Add(item.EndTime).ToString("h:mm tt")</span>
                            <span><i class="fas fa-rupee-sign me-1"></i>&#8377;@item.TotalAmount.ToString("N0")</span>
                        </div>
                        @if (!string.IsNullOrEmpty(item.Notes))
                        {
                            <p style="font-size:0.8rem;color:#94A3B8;margin-top:6px;margin-bottom:0;"><i class="fas fa-sticky-note me-1"></i>@item.Notes</p>
                        }
                        @if (item.Status == BookingStatus.Completed && item.Review != null)
                        {
                            <div class="star-rating mt-2" style="font-size:0.82rem;">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <i class="@(i <= item.Review.Rating ? "fas fa-star" : "far fa-star")"></i>
                                }
                                <span style="color:#64748B;margin-left:4px;">Reviewed</span>
                            </div>
                        }
                    </div>
                </div>
                <div class="d-flex gap-2 align-items-center flex-wrap">
                    <span class="badge-status badge-@item.Status.ToString().ToLower()">
                        <i class="fas fa-circle" style="font-size:0.4rem;"></i>@item.Status
                    </span>
                    @if (item.Status == BookingStatus.Pending || item.Status == BookingStatus.Accepted)
                    {
                        <form asp-controller="Bookings" asp-action="Cancel" method="post" style="margin:0;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@item.Id" />
                            <button type="submit" class="btn btn-sm" data-confirm="Are you sure you want to cancel this booking?"
                                    style="background:rgba(239,68,68,0.08);color:#DC2626;border:1px solid rgba(239,68,68,0.2);border-radius:8px;font-size:0.8rem;padding:5px 14px;">
                                <i class="fas fa-times me-1"></i>Cancel
                            </button>
                        </form>
                    }
                    @if (item.Status == BookingStatus.Completed && item.Review == null)
                    {
                        <a asp-controller="Bookings" asp-action="Review" asp-route-bookingId="@item.Id"
                           class="btn-hub-primary" style="padding:6px 14px;font-size:0.8rem;">
                            <i class="fas fa-star me-1"></i>Write Review
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>;
}

<div style="background:linear-gradient(135deg,#0F172A,#1E1B4B);padding:48px 0 32px;">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-8">
                <h1 style="color:white;font-weight:800;font-size:2rem;margin-bottom:8px;">
                    <i class="fas fa-calendar-check me-2" style="color:#818CF8;"></i>My Bookings
                </h1>
                <p style="color:rgba(255,255,255,0.75);margin:0;">
                    Welcome back, <strong>@(string.IsNullOrWhiteSpace(Model.CustomerName) ? "Customer" : Model.CustomerName)</strong> — track and manage all your service bookings.
                </p>
            </div>
            <div class="col-md-4 text-md-end mt-3 mt-md-0">
                <a asp-controller="Services" asp-action="Browse" class="btn-hub-primary">
                    <i class="fas fa-plus me-2"></i>Book New Service
                </a>
            </div>
        </div>

        <!-- Summary Counts Row -->
        <div class="row g-3 mt-3">
            <div class="col-6 col-md-3">
                <div style="background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.1);border-radius:12px;padding:16px;text-align:center;">
                    <div style="font-size:1.8rem;font-weight:800;color:white;">@Model.AllBookings.Count</div>
                    <div style="font-size:0.78rem;color:rgba(255,255,255,0.6);">Total Bookings</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div style="background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.1);border-radius:12px;padding:16px;text-align:center;">
                    <div style="font-size:1.8rem;font-weight:800;color:#818CF8;">@Model.ActiveBookings.Count</div>
                    <div style="font-size:0.78rem;color:rgba(255,255,255,0.6);">Active</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div style="background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.1);border-radius:12px;padding:16px;text-align:center;">
                    <div style="font-size:1.8rem;font-weight:800;color:#10B981;">@Model.CompletedBookings.Count</div>
                    <div style="font-size:0.78rem;color:rgba(255,255,255,0.6);">Completed</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div style="background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.1);border-radius:12px;padding:16px;text-align:center;">
                    <div style="font-size:1.8rem;font-weight:800;color:#F87171;">@Model.CancelledOrRejectedBookings.Count</div>
                    <div style="font-size:0.78rem;color:rgba(255,255,255,0.6);">Cancelled / Rejected</div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container" style="padding:40px 15px;">
    @if (TempData["Success"] is string successMessage)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4" role="alert">
            <i class="fas fa-check-circle me-2"></i>@successMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] is string errorMessage)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-4" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>@errorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!Model.AllBookings.Any())
    {
        <div class="card-hub p-4">
            <div class="empty-state">
                <div class="empty-state-icon"><i class="fas fa-calendar-times"></i></div>
                <h4>No bookings yet</h4>
                <p>You haven't booked any services yet. Browse verified local experts and book your first appointment.</p>
                <a asp-controller="Services" asp-action="Browse" class="btn-hub-primary mt-3 d-inline-block">
                    <i class="fas fa-search me-2"></i>Browse Services
                </a>
            </div>
        </div>
    }
    else
    {
        <!-- Tabs -->
        <ul class="nav nav-tabs-hub mb-4">
            <li class="nav-item">
                <a class="nav-link active" data-bs-toggle="tab" data-bs-target="#allTab" role="button">
                    <i class="fas fa-list me-1"></i>All Bookings
                    <span class="badge ms-1" style="background:#0F172A;font-size:0.7rem;">@Model.AllBookings.Count</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" data-bs-toggle="tab" data-bs-target="#activeTab" role="button">
                    <i class="fas fa-clock me-1"></i>Active
                    @if (Model.ActiveBookings.Any())
                    {
                        <span class="badge ms-1" style="background:#4F46E5;font-size:0.7rem;">@Model.ActiveBookings.Count</span>
                    }
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" data-bs-toggle="tab" data-bs-target="#completedTab" role="button">
                    <i class="fas fa-check-circle me-1"></i>Completed
                    @if (Model.CompletedBookings.Any())
                    {
                        <span class="badge ms-1" style="background:#10B981;font-size:0.7rem;">@Model.CompletedBookings.Count</span>
                    }
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" data-bs-toggle="tab" data-bs-target="#cancelledTab" role="button">
                    <i class="fas fa-ban me-1"></i>Cancelled / Rejected
                    @if (Model.CancelledOrRejectedBookings.Any())
                    {
                        <span class="badge ms-1" style="background:#EF4444;font-size:0.7rem;">@Model.CancelledOrRejectedBookings.Count</span>
                    }
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" data-bs-toggle="tab" data-bs-target="#reviewTab" role="button">
                    <i class="fas fa-star me-1"></i>Leave Reviews
                    @if (Model.PendingReviewBookings.Any())
                    {
                        <span class="badge ms-1" style="background:#F59E0B;font-size:0.7rem;">@Model.PendingReviewBookings.Count</span>
                    }
                </a>
            </li>
        </ul>

        <div class="tab-content">
            <!-- All Bookings Tab (Default on first load) -->
            <div class="tab-pane fade show active" id="allTab">
                <div class="row g-3">
                    @foreach (var booking in Model.AllBookings)
                    {
                        @BookingCard(booking)
                    }
                </div>
            </div>

            <!-- Active Bookings Tab -->
            <div class="tab-pane fade" id="activeTab">
                @if (!Model.ActiveBookings.Any())
                {
                    <div class="empty-state">
                        <div class="empty-state-icon"><i class="fas fa-calendar-times"></i></div>
                        <h4>No active bookings</h4>
                        <p>Browse services and book your next appointment.</p>
                        <a asp-controller="Services" asp-action="Browse" class="btn-hub-primary mt-3 d-inline-block">Browse Services</a>
                    </div>
                }
                else
                {
                    <div class="row g-3">
                        @foreach (var booking in Model.ActiveBookings)
                        {
                            @BookingCard(booking)
                        }
                    </div>
                }
            </div>

            <!-- Completed Tab -->
            <div class="tab-pane fade" id="completedTab">
                @if (!Model.CompletedBookings.Any())
                {
                    <div class="empty-state">
                        <div class="empty-state-icon"><i class="fas fa-check-circle"></i></div>
                        <h4>No completed bookings</h4>
                        <p>Your completed service history will appear here.</p>
                    </div>
                }
                else
                {
                    <div class="row g-3">
                        @foreach (var booking in Model.CompletedBookings)
                        {
                            @BookingCard(booking)
                        }
                    </div>
                }
            </div>

            <!-- Cancelled / Rejected Tab -->
            <div class="tab-pane fade" id="cancelledTab">
                @if (!Model.CancelledOrRejectedBookings.Any())
                {
                    <div class="empty-state">
                        <div class="empty-state-icon"><i class="fas fa-ban"></i></div>
                        <h4>No cancelled or rejected bookings</h4>
                        <p>Any cancelled or rejected bookings will appear here.</p>
                    </div>
                }
                else
                {
                    <div class="row g-3">
                        @foreach (var booking in Model.CancelledOrRejectedBookings)
                        {
                            @BookingCard(booking)
                        }
                    </div>
                }
            </div>

            <!-- Review Tab -->
            <div class="tab-pane fade" id="reviewTab">
                @if (!Model.PendingReviewBookings.Any())
                {
                    <div class="empty-state">
                        <div class="empty-state-icon"><i class="fas fa-star"></i></div>
                        <h4>All caught up!</h4>
                        <p>You've reviewed all your completed bookings. Thank you!</p>
                    </div>
                }
                else
                {
                    <div class="row g-3">
                        @foreach (var booking in Model.PendingReviewBookings)
                        {
                            <div class="col-12 col-md-6">
                                <div class="card-hub p-4">
                                    <div style="display:flex;align-items:center;gap:12px;margin-bottom:14px;">
                                        <div class="avatar-placeholder" style="width:40px;height:40px;border-radius:10px;">
                                            <i class="@(booking.Service?.Category?.IconClass ?? "fas fa-wrench")"></i>
                                        </div>
                                        <div>
                                            <div style="font-weight:700;font-size:0.9rem;">@booking.Service?.Title</div>
                                            <div style="font-size:0.78rem;color:#94A3B8;">@booking.BookingDate.ToString("MMM d, yyyy")</div>
                                        </div>
                                    </div>
                                    <a asp-controller="Bookings" asp-action="Review" asp-route-bookingId="@booking.Id"
                                       class="btn-hub-primary w-100 d-block text-center" style="padding:10px;font-size:0.85rem;">
                                        <i class="fas fa-star me-2"></i>Write Review
                                    </a>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    }
</div>
