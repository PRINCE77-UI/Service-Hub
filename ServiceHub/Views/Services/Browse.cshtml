@using ServiceHub.Models
@model List<ServiceHub.Models.Service>
@{
    ViewData["Title"] = "Browse Services";
    var categories = ViewBag.Categories as List<Category> ?? new List<Category>();
    var indianCities = ViewBag.IndianCities as List<string> ?? ServiceHub.Models.IndianCities.All;
}

<div style="background:linear-gradient(135deg,#0F172A,#1E293B);padding:48px 0 32px;">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-8">
                <h1 style="color:white;font-weight:800;font-size:2rem;margin-bottom:8px;">
                    <i class="fas fa-search me-2" style="color:#818CF8;"></i>Browse Services
                </h1>
                <p style="color:rgba(255,255,255,0.6);margin:0;">@Model.Count professional service listings found</p>
            </div>
            <div class="col-md-4 mt-3 mt-md-0">
                <form asp-controller="Services" asp-action="Browse" method="get">
                    <div class="input-group">
                        <input type="text" name="keyword" class="form-control" placeholder="Search services..."
                               value="@ViewBag.Keyword" style="background:rgba(255,255,255,0.08);border:1px solid rgba(255,255,255,0.15);color:white;" />
                        <button class="btn" style="background:var(--primary);color:white;" type="submit">
                            <i class="fas fa-search"></i>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="container" style="padding:40px 15px;">
    <div class="row g-4">
        <!-- Sidebar Filters -->
        <div class="col-lg-3">
            <form asp-controller="Services" asp-action="Browse" method="get" id="filterForm">
                <div class="card-hub p-4 mb-3">
                    <h6 style="font-weight:700;font-size:0.85rem;text-transform:uppercase;letter-spacing:0.06em;color:#374151;margin-bottom:14px;">
                        <i class="fas fa-filter me-2 text-primary"></i>Filter Results
                    </h6>

                    <div class="mb-3">
                        <label class="form-label" style="font-size:0.82rem;font-weight:600;color:#64748B;">City</label>
                        <select name="city" class="form-select form-select-sm">
                            <option value="">All Cities</option>
                            @foreach (var city in indianCities)
                            {
                                <option value="@city" selected="@(ViewBag.City?.ToString() == city ? "selected" : null)">@city</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label" style="font-size:0.82rem;font-weight:600;color:#64748B;">Category</label>
                        <div class="d-flex flex-column gap-1">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="categoryId" id="catAll" value="" @(ViewBag.CategoryId == null ? "checked" : "") onchange="document.getElementById('filterForm').submit()" />
                                <label class="form-check-label" for="catAll" style="font-size:0.85rem;">All Categories</label>
                            </div>
                            @foreach (var cat in categories)
                            {
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="categoryId" id="cat@(cat.Id)"
                                           value="@cat.Id" @(ViewBag.CategoryId?.ToString() == cat.Id.ToString() ? "checked" : "")
                                           onchange="document.getElementById('filterForm').submit()" />
                                    <label class="form-check-label" for="cat@(cat.Id)" style="font-size:0.85rem;">
                                        <i class="@(cat.IconClass ?? "fas fa-wrench") me-1 text-primary"></i>@cat.Name
                                    </label>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label" style="font-size:0.82rem;font-weight:600;color:#64748B;">Sort By</label>
                        <select name="sort" class="form-select form-select-sm" onchange="document.getElementById('filterForm').submit()">
                            <option value="">Newest First</option>
                            <option value="price_asc" selected="@(ViewBag.Sort == "price_asc" ? "selected" : null)">Price: Low to High</option>
                            <option value="price_desc" selected="@(ViewBag.Sort == "price_desc" ? "selected" : null)">Price: High to Low</option>
                            <option value="rating" selected="@(ViewBag.Sort == "rating" ? "selected" : null)">Top Rated</option>
                        </select>
                    </div>

                    <button type="submit" class="btn-hub-primary w-100" style="padding:10px;">Apply Filters</button>
                    <a asp-controller="Services" asp-action="Browse" class="btn-hub-ghost w-100 mt-2" style="display:block;text-align:center;padding:9px;">
                        <i class="fas fa-times me-1"></i>Clear Filters
                    </a>
                </div>
            </form>
        </div>

        <!-- Service Grid -->
        <div class="col-lg-9">
            @if (!Model.Any())
            {
                <div class="empty-state">
                    <div class="empty-state-icon"><i class="fas fa-search"></i></div>
                    <h4>No services found</h4>
                    <p>Try adjusting your filters or search terms.</p>
                    <a asp-controller="Services" asp-action="Browse" class="btn-hub-primary mt-3">Clear All Filters</a>
                </div>
            }
            else
            {
                <div class="row g-4">
                    @foreach (var service in Model)
                    {
                        <div class="col-12 col-md-6 col-xl-4 fade-in-up">
                            <div class="card-hub h-100">
                                <div style="overflow:hidden;height:180px;position:relative;">
                                    <img src="@(service.ImageUrl ?? "/images/default-service.svg")"
                                         class="card-img-top" alt="@service.Title" loading="lazy"
                                         onerror="this.onerror=null;this.src='/images/default-service.svg';" />
                                    <div style="position:absolute;top:10px;left:10px;">
                                        <span style="background:rgba(15,23,42,0.8);color:white;padding:3px 10px;border-radius:999px;font-size:0.72rem;font-weight:600;backdrop-filter:blur(6px);">
                                            <i class="@(service.Category?.IconClass ?? "fas fa-wrench") me-1"></i>@service.Category?.Name
                                        </span>
                                    </div>
                                </div>
                                <div class="card-body d-flex flex-column" style="padding:18px;">
                                    <h5 style="font-size:0.9rem;font-weight:700;margin-bottom:8px;" class="truncate-2">@service.Title</h5>

                                    <div class="d-flex align-items-center gap-2 mb-2">
                                        <div class="avatar-placeholder" style="width:24px;height:24px;font-size:0.65rem;">
                                            @(service.Provider?.FullName?.FirstOrDefault().ToString().ToUpper() ?? "P")
                                        </div>
                                        <span style="font-size:0.8rem;color:#64748B;">@service.Provider?.FullName</span>
                                        @if (service.Provider?.IsVerified == true)
                                        {
                                            <i class="fas fa-check-circle" style="color:#10B981;font-size:0.75rem;" title="Verified"></i>
                                        }
                                    </div>

                                    @if (!string.IsNullOrEmpty(service.City))
                                    {
                                        <div style="font-size:0.78rem;color:#94A3B8;margin-bottom:6px;">
                                            <i class="fas fa-map-marker-alt me-1"></i>@service.City
                                        </div>
                                    }

                                    @if (service.ReviewCount > 0)
                                    {
                                        <div class="star-rating mb-2" style="font-size:0.78rem;">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                <i class="@(i <= (int)Math.Round(service.AverageRating) ? "fas fa-star" : "far fa-star")"></i>
                                            }
                                            <span style="color:#64748B;margin-left:4px;">@service.AverageRating.ToString("F1") (@service.ReviewCount)</span>
                                        </div>
                                    }

                                    <div class="mt-auto pt-2 d-flex justify-content-between align-items-center" style="border-top:1px solid #F1F5F9;">
                                        <div>
                                            <span class="price-tag" style="font-size:1.2rem;">&#8377;@service.Price.ToString("N0")</span>
                                            <span class="price-type-badge">@service.PriceType.ToString().ToLower()</span>
                                        </div>
                                        <a asp-controller="Services" asp-action="Details" asp-route-id="@service.Id"
                                           class="btn-hub-ghost" style="padding:6px 14px;font-size:0.78rem;">
                                            View <i class="fas fa-arrow-right ms-1"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>
